pipeline {
    agent {
        label 'docker-runner'
    }

    options {
        timeout(time: 1, unit: 'HOURS')
        retry(2)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
    }

    environment {
        APP_NAME                = 'app-service'
        REGISTRY_HOST           = 'registry.company.com'
        IMAGE_NAME              = "${REGISTRY_HOST}/${APP_NAME}"
        IMAGE_TAG               = "${BUILD_NUMBER}-${GIT_COMMIT[0..7]}"
        DOCKER_BUILDKIT         = '1'
        REGISTRY_CREDENTIALS_ID = 'docker-registry-credentials'
        SONAR_TOKEN             = credentials('sonar-auth-token')
        KUBECONFIG_CRED_ID      = 'k8s-cluster-credentials'
    }

    stages {
        stage('Checkout & Environment Setup') {
            steps {
                checkout scm
                sh 'git config --global --add safe.directory *'
            }
        }

        stage('Parallel Analysis & Verification') {
            parallel {
                stage('Code Linting') {
                    steps {
                        sh '''
                            docker run --rm \
                                -v "$PWD":/app -w /app \
                                -v /tmp/npm-cache:/root/.npm \
                                node:20-alpine npm ci && npm run lint
                        '''
                    }
                }

                stage('Unit Testing & Coverage') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''
                                docker run --rm \
                                    -v "$PWD":/app -w /app \
                                    -v /tmp/npm-cache:/root/.npm \
                                    node:20-alpine npm ci && npm run test:unit -- --coverage
                            '''
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: '**/junit.xml'
                            publishCoverage adapters: [istanbulSonarAdapter('coverage/clover.xml')], calculateDiffForChange: true
                        }
                    }
                }

                stage('SAST & SonarQube Analysis') {
                    steps {
                        script {
                            def scannerHome = tool 'SonarScanner'
                            withSonarQubeEnv('SonarQubeServer') {
                                sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=${APP_NAME} -Dsonar.sources=."
                            }
                        }
                    }
                }
            }
        }

        stage('Container Build & Security Scan') {
            stages {
                stage('Build OCI Image') {
                    steps {
                        script {
                            docker.withRegistry("https://${REGISTRY_HOST}", REGISTRY_CREDENTIALS_ID) {
                                sh """
                                    docker buildx build \
                                        --cache-from type=registry,ref=${IMAGE_NAME}:buildcache \
                                        --cache-to type=registry,ref=${IMAGE_NAME}:buildcache,mode=max \
                                        --build-arg BUILDKIT_INLINE_CACHE=1 \
                                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                                        -t ${IMAGE_NAME}:latest \
                                        --load .
                                """
                            }
                        }
                    }
                }

                stage('Container Vulnerability Scan') {
                    steps {
                        sh """
                            trivy image \
                                --exit-code 1 \
                                --severity HIGH,CRITICAL \
                                --ignore-unfixed \
                                ${IMAGE_NAME}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        stage('Publish Artifacts') {
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_HOST}", REGISTRY_CREDENTIALS_ID) {
                        sh """
                            docker push ${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                withKubeConfig(credentialsId: KUBECONFIG_CRED_ID) {
                    sh """
                        kubectl set image deployment/${APP_NAME} ${APP_NAME}=${IMAGE_NAME}:${IMAGE_TAG} -n staging
                        kubectl rollout status deployment/${APP_NAME} -n staging --timeout=300s
                    """
                }
            }
        }

        stage('Deploy to Production') {
            when {
                buildingTag()
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                input message: "Approve deployment to Production?", ok: "Deploy"
                withKubeConfig(credentialsId: KUBECONFIG_CRED_ID) {
                    sh """
                        kubectl set image deployment/${APP_NAME} ${APP_NAME}=${IMAGE_NAME}:${IMAGE_TAG} -n production
                        kubectl rollout status deployment/${APP_NAME} -n production --timeout=300s
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: true, notFailBuild: true
            sh 'docker image prune -f --filter "until=24h"'
        }
        success {
            slackSend channel: '#deployments', color: '#00FF00', message: "SUCCESSFUL: Pipeline '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]"
        }
        failure {
            slackSend channel: '#deployments', color: '#FF0000', message: "FAILED: Pipeline '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]"
        }
    }
}